# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Scraping Config
SCRAPE_INTERVAL_MINUTES=60
MIN_MATCH_SCORE=70
MAX_CONCURRENT_SCRAPERS=3
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0

# Database
DB_PATH=jobs.db

# Target Companies (comma-separated)
GREENHOUSE_COMPANIES=["figma","notion","stripe","ramp","linear"]
LEVER_COMPANIES=["netlify","postman"]
ASHBY_COMPANIES=["linear","notion"]

# Search Keywords
SEARCH_KEYWORDS=["software engineer","backend engineer","full stack developer","python developer"]
